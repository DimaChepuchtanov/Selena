# Copy to .env.production in the project root on the VPS, keep it PRIVATE.
# Replace all example values with your own unique credentials.
SITE_DOMAIN=example.ru
DJANGO_SETTINGS_MODULE=manager.settings.prod
SECRET_KEY=REPLACE_WITH_FRESH_RANDOM_SECRET_AT_LEAST_32_CHARS

PG_USER=selena
PG_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DB_PASSWORD
PG_DATABASE=selena
PG_SSLMODE=prefer

# HTTPS is terminated by the host nginx on the same VPS.
USE_HTTPS=1
TRUST_PROXY_SSL_HEADER=1
HSTS_SECONDS=0
