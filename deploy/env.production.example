# Template only. Put actual values in a private file outside the public document root.
SITE_DOMAIN=example.ru
DJANGO_SETTINGS_MODULE=manager.settings.prod
SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=selena
PG_USER=selena
PG_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# For an external PostgreSQL provider use require, verify-ca or verify-full.
PG_SSLMODE=prefer

# Set USE_HTTPS=0 only during isolated, non-public local staging.
USE_HTTPS=1
# Only for a trusted reverse proxy that always replaces X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=0
# Raise gradually after the HTTPS certificate and redirects are verified.
HSTS_SECONDS=0
