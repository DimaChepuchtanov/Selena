# VPS ONLY; not installable on shared REG.RU Host-A.
# Replace example.ru and /srv/selena with your real values.
# Provision HTTPS with a certificate before serving this site publicly.
server {
    listen 80;
    server_name example.ru www.example.ru;
    root /srv/selena/frontend/dist;
    index index.html;
    server_tokens off;
    client_max_body_size 20m;

    # For the initial certificate enrollment only; redirect to HTTPS afterwards.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location ~ /\. {
        deny all;
        return 404;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /user/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /media/ {
        alias /srv/selena/media/;
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
    }
    location ^~ /django-static/ {
        alias /srv/selena/staticfiles/;
        try_files $uri =404;
    }
    location ^~ /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control public;
    }
    location ^~ /static/ {
        try_files $uri =404;
        expires 7d;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
