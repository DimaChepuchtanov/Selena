# Host nginx example for Ubuntu/Debian VPS; install an HTTPS certificate via Certbot.
# Replace example.ru before enabling. This first-stage config listens on HTTP only.
server {
    listen 80;
    listen [::]:80;
    server_name example.ru www.example.ru;
    client_max_body_size 20m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
# After HTTP works, obtain a certificate:
# sudo certbot --nginx -d example.ru -d www.example.ru
# The www name must also resolve to the VPS before requesting its certificate.
# Certbot will set up a 443 server block; select HTTP -> HTTPS redirection.
